@page "/finance"
@using Finora.Models
@inject IFinService FinService
@inject NavigationManager NavManager

<div class="finance-page">
    <header class="finance-header">
        <div>
            <h1>Finance</h1>
        </div>
        <div class="hero-total">
            <span class="hero-label">Total tracked</span>
            <span class="hero-value">@totalAmount.ToString("C")</span>
        </div>
    </header>
    <div class="hero-total">
        <button @onclick="() => OpenModalCreate()">+</button>
    </div>
    @if (fins == null)
    {
        <p class="status-text">A carregar o teu livro de contas...</p>
    }
    else if (!fins.Any())
    {
        <div class="empty-state">
            <p>Ainda não há nada registado.</p>
            <span>Assim que adicionares dados pela API, aparecem aqui.</span>
        </div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var f in fins)
            {
                <div class="fin-card">
                    <div class="fin-avatar">@GetInitial(f.Name)</div>
                    <h3 class="fin-name">@f.Name</h3>
                    <p class="fin-desc">@f.Description</p>
                    <p class="fin-amount">@f.Amount.ToString("C")</p>
                    <button @onclick="() => DeleteFin(f.Id)">Delete</button>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Fin>? fins;

    private decimal totalAmount => fins?.Sum(f => f.Amount) ?? 0;

    private static readonly string[] accents = { "#f2b84b", "#8b7fd1", "#5ec8c0", "#d97ea0" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            fins = await FinService.GetAllFinsAsync();
        }
        catch
        {
            fins = new List<Fin>();
        }
    }

    private string GetInitial(string name) =>
        string.IsNullOrEmpty(name) ? "?" : name[0].ToString().ToUpper();

    private string GetAccent(string name)
    {
        int hash = 0;
        foreach (var c in name ?? "")
            hash = c + ((hash << 5) - hash);
        var idx = Math.Abs(hash) % accents.Length;
        return accents[idx];
    }
    private async Task DeleteFin(int id)
    {
        await FinService.DeleteFin(id);
        fins?.RemoveAll(f => f.Id == id);
    }
    private void OpenModalCreate()
    {
        NavManager.NavigateTo("/createFin");
    }
}