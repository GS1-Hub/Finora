@page "/finance"
@inject Finora.Services.Interfaces.IFinService FinService

<h1>Finance</h1>

@if (fins == null)
{
    <p>A carregar...</p>
}
else if (!fins.Any())
{
    <p>Sem registos ainda.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Amount</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in fins)
            {
                <tr>
                    <td>@f.Name</td>
                    <td>@f.Description</td>
                    <td>@f.Amount.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Fin>? fins;

    protected override async Task OnInitializedAsync()
    {
        fins = await FinService.GetAllFinsAsync();
    }

}